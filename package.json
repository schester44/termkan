{
  "name": "termkan",
  "version": "1.0.0",
  "description": "A terminal Kanban board built with React Ink",
  "main": "dist/app.js",
  "bin": {
    "tk": "./bin/tk.js"
  },
  "scripts": {
    "start": "yarn tsx src/app.tsx",
    "build": "tsc",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepare": "husky"
  },
  "keywords": [
    "kanban",
    "terminal",
    "tui",
    "cli",
    "board"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@vimee/core": "^0.3.0",
    "ink": "^7.0.6",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.7",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "zustand": "^5.0.14"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "typescript-eslint": "^8.61.0"
  }
}
